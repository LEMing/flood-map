{
  "name": "flood-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Address-based 3D terrain + physically-based GPU rain-flood simulation (three.js)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-place-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-circular": "node scripts/check-circular-deps.mjs",
    "check-layers": "depcruise --config dependency-cruiser.config.cjs src",
    "check-arch": "npm run check-circular && npm run check-layers"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "mp4-muxer": "^5.2.2",
    "proj4": "^2.20.9",
    "three": "^0.184.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tweakpane/core": "^2.0.5",
    "@types/proj4": "^2.5.6",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "madge": "^8.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
